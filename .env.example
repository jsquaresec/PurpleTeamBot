# ==============================================================================
# PURPLE TEAM BOT — PRODUCTION ENVIRONMENT
# J2SEC / JSquareSec
# ==============================================================================
# Copy this file to `.env` and fill in the values you use.
#
# REQUIRED:
#   DISCORD_TOKEN
#
# RECOMMENDED:
#   DISCORD_GUILD_ID
#   BOT_OWNER_ID
#
# SECURITY:
#   Never commit your real `.env` file, tokens, passwords, or API keys.
# ==============================================================================


# ==============================================================================
# DISCORD
# ==============================================================================

DISCORD_TOKEN=
DISCORD_GUILD_ID=
BOT_OWNER_ID=

# Private owner-only server blueprint. The default points at a gitignored file.
SERVER_TEMPLATE_PATH=private/j2_server_template.json

# Comma-separated Discord channel IDs where Purple Team application commands
# are allowed to run. These production IDs are also the built-in defaults.
DISCORD_ALLOWED_CHANNEL_IDS=1547700463611289640,1548426555934376096,1548416136436129983,1548426462120386672,1548437367331881030

# Dedicated outbound-only announcement channel for the daily Purple Team Snapshot.
# Application commands remain blocked here unless this ID is also added to the
# allowlist above.
DISCORD_SNAPSHOT_CHANNEL_ID=1547422897054818355

# Snapshot behavior: after the bot/service restarts and Discord is ready, wait a
# few seconds and post the daily card. A local date marker prevents duplicate
# automatic cards when the service is restarted more than once in the same day.
SNAPSHOT_TIMEZONE=America/Chicago
SNAPSHOT_STARTUP_DELAY_SECONDS=15
SNAPSHOT_STATE_PATH=.purple_team_snapshot_date


# ==============================================================================
# DATABASE
# ==============================================================================
# SQLite remains the zero-config fallback.
# If DATABASE_URL is populated, Purple Team uses PostgreSQL / Neon instead.

DATABASE_PATH=purple_team.db
DATABASE_URL=
# Example Neon URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require


# ==============================================================================
# CORE APPLICATION
# ==============================================================================

MAX_ACTIVE_SCANS=1
SCAN_TIMEOUT_SECONDS=90
HTTP_TIMEOUT_SECONDS=12
USER_AGENT=PurpleTeamBot/0.1


# ==============================================================================
# PERSON INTELLIGENCE — YOU.COM WEB SEARCH
# ==============================================================================
# Primary open-web OSINT source for /person search.
# Current free tier: up to 100 Web Search requests per day.

YOU_API_KEY=


# ==============================================================================
# OPTIONAL PERSON INTELLIGENCE — PERSONPAGES
# ==============================================================================
# Optional structured provider if account access is approved.
# PersonPages profile fields are AI-estimated from public signals and should be
# treated as correlation leads, not verified facts.
PERSONPAGES_API_KEY=


# ==============================================================================
# OPTIONAL PAID / THIRD-PARTY INTELLIGENCE
# ==============================================================================
ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=
ENFORMION_SEARCH_TYPE=Person
ENFORMION_BASE_URL=https://devapi.enformion.com/PersonSearch

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
CENSYS_PAT=
URLSCAN_API_KEY=
OTX_API_KEY=
