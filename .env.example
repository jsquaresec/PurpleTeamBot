# ==============================================================================
# PURPLE TEAM BOT — PRODUCTION ENVIRONMENT
# J2SEC / JSquareSec
# ==============================================================================
# Copy this file to `.env` and fill in the values you use.
#
# REQUIRED:
#   DISCORD_TOKEN
#   DISCORD_ALLOWED_CHANNEL_IDS
#
# RECOMMENDED:
#   DISCORD_GUILD_ID
#   BOT_OWNER_ID
#
# SECURITY:
#   Never commit your real `.env` file, tokens, passwords, or API keys.
# ==============================================================================


# ==============================================================================
# DISCORD
# ==============================================================================

DISCORD_TOKEN=
DISCORD_GUILD_ID=
BOT_OWNER_ID=

# Comma-separated Discord channel IDs where Purple Team is allowed to operate.
# The command guard fails closed: if this is blank, application commands are denied.
# Example:
# DISCORD_ALLOWED_CHANNEL_IDS=123456789012345678,234567890123456789
DISCORD_ALLOWED_CHANNEL_IDS=


# ==============================================================================
# DATABASE
# ==============================================================================
# SQLite remains the zero-config fallback.
# If DATABASE_URL is populated, Purple Team uses PostgreSQL / Neon instead.

DATABASE_PATH=purple_team.db
DATABASE_URL=
# Example Neon URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require


# ==============================================================================
# CORE APPLICATION
# ==============================================================================

MAX_ACTIVE_SCANS=1
SCAN_TIMEOUT_SECONDS=90
HTTP_TIMEOUT_SECONDS=12
USER_AGENT=PurpleTeamBot/0.1


# ==============================================================================
# PERSON INTELLIGENCE — YOU.COM WEB SEARCH
# ==============================================================================
# Primary open-web OSINT source for /person search.
# Current free tier: up to 100 Web Search requests per day.

YOU_API_KEY=


# ==============================================================================
# OPTIONAL PERSON INTELLIGENCE — PERSONPAGES
# ==============================================================================
# Optional structured provider if account access is approved.
# PersonPages profile fields are AI-estimated from public signals and should be
# treated as correlation leads, not verified facts.

PERSONPAGES_API_KEY=


# ==============================================================================
# LEGACY / OPTIONAL PERSON PROVIDER — ENFORMIONGO
# ==============================================================================
# Retained only for future troubleshooting. Current /person and /reverse
# commands do not depend on EnformionGO.

ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=
ENFORMION_SEARCH_TYPE=Person
ENFORMION_BASE_URL=https://devapi.enformion.com/PersonSearch


# ==============================================================================
# THREAT INTELLIGENCE — VIRUSTOTAL
# ==============================================================================

VIRUSTOTAL_API_KEY=


# ==============================================================================
# IP REPUTATION — ABUSEIPDB
# ==============================================================================

ABUSEIPDB_API_KEY=


# ==============================================================================
# INTERNET EXPOSURE — CENSYS
# ==============================================================================

CENSYS_PAT=


# ==============================================================================
# WEB / URL INTELLIGENCE — URLSCAN.IO
# ==============================================================================

URLSCAN_API_KEY=


# ==============================================================================
# THREAT / IOC INTELLIGENCE — ALIENVAULT OTX
# ==============================================================================

OTX_API_KEY=


# ==============================================================================
# FREE BUILT-IN / NO API KEY REQUIRED
# ==============================================================================
# USACallerLookup       — US phone carrier/location/FTC complaint intelligence
# XposedOrNot           — email breach exposure lookup
# GitHub / GitLab       — name and public-profile correlation
# Reddit / Keybase / HackerOne — derived username correlation
# HIBP Pwned Passwords  — k-anonymity password exposure lookup
# FIRST EPSS            — exploitation probability
# CISA KEV              — known exploited vulnerabilities
# crt.sh                — certificate-transparency discovery
# DNS / RDAP            — public registration and DNS intelligence
# Nmap                  — local authorized assessment engine
# ==============================================================================


# ==============================================================================
# NOT REQUIRED
# ==============================================================================
# People Data Labs
# Digital Footprint
# HIBP paid account API
# Shodan
# SecurityTrails
# ==============================================================================


# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================
