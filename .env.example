# ==============================================================================
# Purple Team Bot — Environment Configuration
# J2SEC / JSquareSec
# ==============================================================================
# Copy this file to `.env` and fill in only the values you use.
#
# REQUIRED:
#   DISCORD_TOKEN
#
# RECOMMENDED FOR DEVELOPMENT:
#   DISCORD_GUILD_ID
#   BOT_OWNER_ID
#
# SECURITY:
#   Never commit your real `.env` file or API keys to GitHub.
# ==============================================================================


# ==============================================================================
# DISCORD
# ==============================================================================

# Required — Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional — Test/development server ID for immediate slash-command syncing.
# Leave blank to use global command syncing.
DISCORD_GUILD_ID=

# Recommended — Discord user ID for bot-owner-only functionality.
BOT_OWNER_ID=


# ==============================================================================
# CORE APPLICATION
# ==============================================================================

# SQLite database file used for scope, audit, and scan-history storage.
DATABASE_PATH=purple_team.db

# Maximum number of active network scans running at the same time.
MAX_ACTIVE_SCANS=1

# Hard timeout for active scan jobs, in seconds.
SCAN_TIMEOUT_SECONDS=90

# Timeout for HTTP, DNS, API, and passive-intelligence requests, in seconds.
HTTP_TIMEOUT_SECONDS=12

# User-Agent sent by Purple Team when making supported outbound requests.
USER_AGENT=PurpleTeamBot/0.1


# ==============================================================================
# PERSON INTELLIGENCE — ENFORMIONGO
# ==============================================================================
# Optional. Used by permission-gated person, phone, email, and address lookups.

ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=
ENFORMION_SEARCH_TYPE=Person
ENFORMION_BASE_URL=https://devapi.enformion.com/PersonSearch


# ==============================================================================
# THREAT INTELLIGENCE — VIRUSTOTAL
# ==============================================================================
# Optional. Used for domain, IP, hash, and supported file-reputation lookups.

VIRUSTOTAL_API_KEY=


# ==============================================================================
# BREACH INTELLIGENCE — HAVE I BEEN PWNED
# ==============================================================================
# Optional. Used for permission-gated breached-account intelligence.

HIBP_API_KEY=


# ==============================================================================
# INTERNET EXPOSURE INTELLIGENCE — SHODAN
# ==============================================================================
# Optional. Used for host, service, ASN, port, and exposure intelligence.

SHODAN_API_KEY=


# ==============================================================================
# IP REPUTATION — ABUSEIPDB
# ==============================================================================
# Optional. Used for abuse-confidence and IP reputation lookups.

ABUSEIPDB_API_KEY=


# ==============================================================================
# PASSIVE DNS / DOMAIN INTELLIGENCE — SECURITYTRAILS
# ==============================================================================
# Optional. Used for passive subdomain and domain intelligence.

SECURITYTRAILS_API_KEY=


# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================
