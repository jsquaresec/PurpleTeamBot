# ==============================================================================
# PURPLE TEAM BOT — PRODUCTION ENVIRONMENT
# J2SEC / JSquareSec
# ==============================================================================
# Copy this file to `.env` and fill in the values you use.
#
# REQUIRED:
#   DISCORD_TOKEN
#
# RECOMMENDED:
#   DISCORD_GUILD_ID
#   BOT_OWNER_ID
#
# SECURITY:
#   Never commit your real `.env` file, tokens, passwords, or API keys.
# ==============================================================================


# ==============================================================================
# DISCORD
# ==============================================================================

# Required — Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional — Development/test server ID for immediate slash-command syncing.
# Leave blank for global command syncing.
DISCORD_GUILD_ID=

# Recommended — Discord user ID for owner-only functionality.
BOT_OWNER_ID=


# ==============================================================================
# DATABASE
# ==============================================================================

# Current local SQLite database path.
# Used unless/until the storage layer is migrated to PostgreSQL.
DATABASE_PATH=purple_team.db

# Reserved for PostgreSQL/Neon migration.
# Leave blank while the bot is using SQLite.
# Example format:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=


# ==============================================================================
# CORE APPLICATION
# ==============================================================================

# Maximum number of active assessment scans at once.
MAX_ACTIVE_SCANS=1

# Hard timeout for active scan jobs, in seconds.
SCAN_TIMEOUT_SECONDS=90

# Timeout for HTTP, DNS, API, and passive-intelligence requests, in seconds.
HTTP_TIMEOUT_SECONDS=12

# User-Agent sent by Purple Team for supported outbound requests.
USER_AGENT=PurpleTeamBot/0.1


# ==============================================================================
# PERSON INTELLIGENCE — ENFORMIONGO
# ==============================================================================
# Optional — permission-gated person, phone, email, and address intelligence.
# Keep this provider; usage is subject to your EnformionGO account allowance.

ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=
ENFORMION_SEARCH_TYPE=Person
ENFORMION_BASE_URL=https://devapi.enformion.com/PersonSearch


# ==============================================================================
# THREAT INTELLIGENCE — VIRUSTOTAL
# ==============================================================================
# Optional — free/public API tier supported.
# Domain, IP, and file-hash reputation intelligence.

VIRUSTOTAL_API_KEY=


# ==============================================================================
# IP REPUTATION — ABUSEIPDB
# ==============================================================================
# Optional — free account/API tier supported.
# Abuse-confidence and IP reputation intelligence.

ABUSEIPDB_API_KEY=


# ==============================================================================
# INTERNET EXPOSURE — CENSYS
# ==============================================================================
# Optional — Censys Free supports host/web-property/certificate lookups.
# Create a Personal Access Token (PAT) in Censys.

CENSYS_PAT=


# ==============================================================================
# WEB / URL INTELLIGENCE — URLSCAN.IO
# ==============================================================================
# Optional — free account/API access supported.
# API key is recommended for usable quotas; limited unauthenticated access exists.

URLSCAN_API_KEY=


# ==============================================================================
# THREAT / IOC INTELLIGENCE — ALIENVAULT OTX
# ==============================================================================
# Optional — free OTX account/API key.
# Used for IP, domain, URL, and hash indicator enrichment.

OTX_API_KEY=


# ==============================================================================
# FREE BUILT-IN / NO PAID API KEY REQUIRED
# ==============================================================================
# These integrations do not require a paid API key in this project:
#
#   XposedOrNot       — email breach exposure lookup
#   HIBP Pwned Passwords — k-anonymity password exposure lookup
#   FIRST EPSS        — exploitation probability
#   CISA KEV          — known exploited vulnerabilities
#   crt.sh            — certificate-transparency subdomain discovery
#   DNS / RDAP        — public registration and DNS intelligence
#   Nmap              — local authorized assessment engine
#
# NOTE: Public/free services still have their own rate limits and terms of use.
# ==============================================================================


# ==============================================================================
# REMOVED PROVIDERS
# ==============================================================================
# The following are intentionally no longer part of the required stack:
#
#   HIBP_API_KEY
#   SHODAN_API_KEY
#   SECURITYTRAILS_API_KEY
#
# Purple Team now uses free-first alternatives for those capabilities.
# ==============================================================================


# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================
